<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF">
    <LinearLayout android:id="@+id/bar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="#EEEEF5" android:gravity="center_vertical" android:padding="4dp">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1"
            android:ellipsize="end" android:paddingStart="8dp" />
        <TextView android:id="@+id/pageNo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingEnd="8dp" />
        <Button android:id="@+id/btnRange" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="범위" />
        <Button android:id="@+id/btnFix" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="색" />
        <Button android:id="@+id/btnMetro" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♩" />
        <Button android:id="@+id/btnLayer" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="레이어" />
        <Button android:id="@+id/btnMenu" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⋯" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/penBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="#FFF4D6" android:visibility="gone">
    <LinearLayout android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="필기 중 " android:paddingStart="8dp" />
        <Button android:id="@+id/penBlack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="검정" />
        <Button android:id="@+id/penRed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="빨강" />
        <Button android:id="@+id/penBlue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="파랑" />
        <Button android:id="@+id/penHi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="형광" />
        <Button android:id="@+id/penErase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="지우개" />
        <Button android:id="@+id/penUndo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="되돌리기" />
        <Button android:id="@+id/penDone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="완료" />
    </LinearLayout>
    </HorizontalScrollView>
    <HorizontalScrollView android:id="@+id/fixBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="#F4F0FA" android:visibility="gone">
    <LinearLayout android:id="@+id/fixRow" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="4dp">
        <TextView android:id="@+id/fixInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="색 고치기: 색을 고른 뒤 음표를 누르세요 " android:paddingStart="8dp" />
        <Button android:id="@+id/fixUndo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="되돌리기" />
        <Button android:id="@+id/fixDone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="완료" />
    </LinearLayout>
    </HorizontalScrollView>
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/pager"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout android:id="@+id/practiceBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="#EEF6EE" android:gravity="center_vertical" android:padding="6dp"
        android:visibility="gone">
        <Button android:id="@+id/rPrev" android:layout_width="48dp" android:layout_height="wrap_content" android:text="◀" />
        <TextView android:id="@+id/rName" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:gravity="center" android:textSize="16sp" android:maxLines="2" />
        <Button android:id="@+id/rNext" android:layout_width="48dp" android:layout_height="wrap_content" android:text="▶" />
        <Button android:id="@+id/rMinus" android:layout_width="64dp" android:layout_height="64dp" android:text="−1" android:textSize="18sp" />
        <Button android:id="@+id/rPlus" android:layout_width="96dp" android:layout_height="64dp" android:text="+1" android:textSize="24sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/metroBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:background="#EEEEF8" android:padding="4dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/mM5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="−5" />
            <Button android:id="@+id/mM1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="−1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="♩=" android:textSize="20sp" android:paddingStart="4dp" />
            <EditText android:id="@+id/mBpm" android:layout_width="0dp" android:layout_weight="1.4"
                android:layout_height="wrap_content" android:gravity="center" android:textSize="22sp"
                android:textStyle="bold" android:inputType="number" android:maxLength="3"
                android:imeOptions="actionDone" android:selectAllOnFocus="true" />
            <Button android:id="@+id/mP1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="+1" />
            <Button android:id="@+id/mP5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="+5" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/mBeats" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="박없음" />
            <Button android:id="@+id/mTap" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="탭" />
            <Button android:id="@+id/mPlay" android:layout_width="0dp" android:layout_weight="1.6" android:layout_height="wrap_content" android:text="▶ 시작" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
